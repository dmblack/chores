# Merge these snippets into the existing HAProxy configuration; this is not a
# replacement for its current frontends, certificates, defaults, or other apps.
# Replace PUBLIC_HOSTNAME and ORIGIN_SECRET with the generated deployment values.
# Keep the rendered config readable only by administrators: it contains a secret.

# Add these two directives INSIDE the existing TLS-terminating HTTP frontend.
# Preserve that frontend's existing client-IP allowlist and deny rules.
# Keep that frontend's timeout client at least 60s for the 25s SSE heartbeat.
#   acl chores_host hdr(host),lower -i PUBLIC_HOSTNAME PUBLIC_HOSTNAME:443
#   use_backend chores_web if chores_host

# Send HTTP only over loopback. The local signer obtains the instance role's
# IMDSv2 credentials, signs each request, and verifies TLS to one fixed AWS origin.
# No periodic HTTP health check is configured, so health checks do not wake Lambda.
backend chores_web
    mode http
    timeout connect 15s
    timeout server 60s

    # Replace client-supplied forwarding and origin headers with trusted values.
    http-request del-header Forwarded
    http-request set-header X-Forwarded-For %[src]
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Host PUBLIC_HOSTNAME
    http-request set-header X-App-Origin-Secret ORIGIN_SECRET

    # The helper overwrites the upstream Host and AWS signing headers itself.
    server signer 127.0.0.1:8787
