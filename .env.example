# Default local storage. Export these settings through your shell or service manager.
# This reference file is not loaded automatically by the application.
STORAGE_BACKEND=sqlite
DB_PATH=./data/chores.db
TZ=Australia/Melbourne

# DynamoDB alternative: uncomment and replace the SQLite backend selection above.
# STORAGE_BACKEND=dynamodb
# AWS_REGION=ap-southeast-2
# DYNAMODB_TABLE=chores
# DYNAMODB_NAMESPACE=household

# Optional local-development endpoint. Leave unset for AWS DynamoDB.
# DYNAMODB_ENDPOINT=http://127.0.0.1:8000

# HTTPS terminated by a trusted reverse proxy such as HAProxy.
# COOKIE_SECURE=true
# TRUST_PROXY=true

# Optional reverse-proxy boundary and protected initial setup.
# The AWS deployment generates these secrets privately; do not commit real values.
# APP_ORIGIN_SECRET=<random-secret-of-at-least-32-bytes>
# BOOTSTRAP_TOKEN=<different-random-secret-of-at-least-32-bytes>
# PUBLIC_ORIGIN=https://tasks.fortheherd.net
