{
  "name": "chores",
  "private": true,
  "version": "0.1.0",
  "description": "Household chores app: mark tasks done, someone else approves, earn points.",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "test": "node --test \"server/test/**/*.test.js\"",
    "icons": "node scripts/make-icons.js",
    "reset-password": "node scripts/reset-password.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@fluentui/react-components": "^9.75.2",
    "@fluentui/react-icons": "^2.0.346",
    "@vitejs/plugin-react": "^6.3.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true
  }
}
